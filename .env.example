# Cloudflare API credentials
CF_TOKEN=your_cf_api_token
CF_ACCOUNT=your_cf_account_id
CF_ZONE=your_cf_zone_id
WORKER_NAME=tempmail-router
DOMAIN=yourdomain.com

# VPS webhook secret (generate with: openssl rand -base64 32)
WEBHOOK_SECRET=your_webhook_secret

# Flask session secret (generate with: python3 -c "import secrets;print(secrets.token_hex(32))")
TEMPMAIL_SECRET=your_flask_secret

# Database path
DB_PATH=/var/lib/tempmail/tempmail.db

# Mailbox TTL in seconds (600 = 10 minutes)
MAILBOX_TTL=600
